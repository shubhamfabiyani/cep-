# ==========================================
# Engineering Scholarship Finder - Environment Variables
# ==========================================

# [Required] MongoDB Atlas Cloud Database URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/scholarship_portal?retryWrites=true&w=majority

# [Required] JWT Secret Key for authenticating students and administrators
JWT_SECRET=super_secret_pict_scholarship_key_2026_10days

# [Required] Initial Administrator credentials
ADMIN_EMAIL=pict@gmail.com
ADMIN_PASSWORD=pict123

# [Optional] Local development backend port (Default: 5000)
PORT=5000

# [Optional] Frontend API URL (Leave blank for production on Vercel so same-origin relative URLs /api/* are used)
VITE_API_URL=

# [Optional] Custom domain for CORS if using a custom domain outside *.vercel.app
ALLOWED_ORIGIN=
